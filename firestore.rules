/**
 * @fileoverview Firestore Security Rules for the FinLit Classroom application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for student-related data (profiles, portfolios, transactions)
 * and provides public read access to global data (rewards, stocks).  Write access to user data is restricted to the
 * authenticated user.
 *
 * Data Structure:
 * - /users/{userId}/student: Stores individual student profiles, owned by the user.
 * - /rewards/{rewardId}: Stores global reward information, publicly readable.
 * - /stocks/{stockId}: Stores global stock information, publicly readable.
 * - /users/{userId}/portfolios/{portfolioId}: Stores student's stock portfolios, owned by the user.
 * - /users/{userId}/transactions/{transactionId}: Stores student's stock transactions, owned by the user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own student data.
 * - Anyone can read the list of rewards and stocks. Writes are denied.
 * - Users can only manage their own portfolios and transactions.
 * - Listing all users is not allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to student profiles, ensuring only the owning user can read and write.
     * @path /users/{userId}/student
     * @allow (create) User 'user_abc' can create their own profile at /users/user_abc/student.
     * @allow (get, update, delete) User 'user_abc' can read, update, and delete their profile at /users/user_abc/student.
     * @deny (create, get, update, delete) User 'user_xyz' cannot access user 'user_abc's profile at /users/user_abc/student.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/student {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to rewards data, but restricts write access.
     * @path /rewards/{rewardId}
     * @allow (get, list) Any user can read reward data.
     * @deny (create, update, delete) No user can create, update, or delete reward data.
     * @principle Provides public read access with restricted write access.
     */
    match /rewards/{rewardId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to stock data, but restricts write access.
     * @path /stocks/{stockId}
     * @allow (get, list) Any user can read stock data.
     * @deny (create, update, delete) No user can create, update, or delete stock data.
     * @principle Provides public read access with restricted write access.
     */
    match /stocks/{stockId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure access to student's stock portfolios, ensuring only the owning user can read and write.
     * @path /users/{userId}/portfolios/{portfolioId}
     * @allow (create) User 'user_abc' can create a portfolio at /users/user_abc/portfolios/portfolio_123.
     * @allow (get, update, delete) User 'user_abc' can read, update, and delete their portfolio at /users/user_abc/portfolios/portfolio_123.
     * @deny (create, get, update, delete) User 'user_xyz' cannot access user 'user_abc's portfolio at /users/user_abc/portfolios/portfolio_123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/portfolios/{portfolioId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.studentId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure access to student's stock transactions, ensuring only the owning user can read and write.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User 'user_abc' can create a transaction at /users/user_abc/transactions/transaction_123.
     * @allow (get, update, delete) User 'user_abc' can read, update, and delete their transaction at /users/user_abc/transactions/transaction_123.
     * @deny (create, get, update, delete) User 'user_xyz' cannot access user 'user_abc's transaction at /users/user_abc/transactions/transaction_123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.studentId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure access to 人生 RPG (life-rpg) per-user app state, used for cross-device sync.
     * @path /life_rpg_users/{userId}
     * @allow (get, create, update, delete) User 'user_abc' can read and write their own document at /life_rpg_users/user_abc.
     * @deny (get, create, update, delete) User 'user_xyz' cannot access user 'user_abc's document.
     * @principle Enforces document ownership for all operations. Unrelated to the FinLit Classroom data above.
     */
    match /life_rpg_users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}