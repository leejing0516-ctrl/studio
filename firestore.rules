// =================================================================================
// ============================= 請您手動更新此規則 ================================
// =================================================================================
//
// 持續出現權限錯誤，代表這些規則沒有成功部署到您的 Firebase 專案。
// 請您依照以下步驟，手動將此檔案的內容更新到 Firebase 網站上：
//
// 1. **複製規則**：
//    複製底下 `rules_version` 到 `}` 之間的所有程式碼。
//
// 2. **前往 Firebase 主控台**：
//    在瀏覽器中開啟您的 Firebase 專案。
//
// 3. **找到 Firestore 設定**：
//    在左側選單中，點擊「建構」 > 「Firestore Database」。
//
// 4. **進入「規則」分頁**：
//    在 Firestore 頁面頂部，找到並點擊「規則」分頁。
//
// 5. **貼上並發布**：
//    將您第一步複製的程式碼，完全覆蓋掉編輯器中現有的所有內容。
//    然後點擊藍色的「發布」按鈕。
//
// 6. **重新整理應用程式**：
//    回到您的應用程式頁面並重新整理。權限錯誤應該就會解決。
//
// =================================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 為了方便開發，此規則允許任何人讀取和寫入您的整個資料庫。
    // 在您的應用程式正式上線前，請務必設定更嚴謹的安全規則。
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
